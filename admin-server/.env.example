# ============================================================
# NATURE'S MUD ADMIN SERVER ENVIRONMENT
# ============================================================
# ⚠️  NEVER COMMIT REAL SECRETS TO VERSION CONTROL
# Generate secure keys with: openssl rand -base64 32

# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/admin

# Database (ADMIN-SPECIFIC MySQL database - separate from Laravel)
# In production, this uses the docker network hostname 'mysql'
DATABASE_URL="mysql://${DB_USERNAME:-naturesmud}:${DB_PASSWORD}@mysql:3306/natures_mud_admin"

# JWT Auth - Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secure-jwt-secret-min-32-chars-here
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-min-32-chars-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Laravel Database (reads orders, customers, products from Laravel backend)
# In production, this uses the docker network hostname 'mysql'
LARAVEL_DB_HOST=mysql
LARAVEL_DB_PORT=3306
LARAVEL_DB_DATABASE=natures_mud
LARAVEL_DB_USER=${DB_USERNAME:-naturesmud}
LARAVEL_DB_PASSWORD=${DB_PASSWORD}

# Cloudinary (Media Uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Gemini (AI Features)
GEMINI_API_KEY=your-gemini-api-key

# SMTP (Email/OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=admin@naturesmud.com
MAIL_FROM_NAME="Nature's Mud"

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# CORS - Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Super Admin Seed (run with: npm run seed) - CHANGE IN PRODUCTION!
SEED_SUPER_ADMIN_EMAIL=superadmin@naturesmud.com
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin@2024
SEED_SUPER_ADMIN_NAME="Super Admin"