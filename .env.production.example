# ============================================================
# NATURE'S MUD — PRODUCTION ENVIRONMENT TEMPLATE
# ============================================================
# Copy this file to .env and fill in ALL values
# NEVER commit the actual .env file to version control!
# ============================================================

# ─────────────────────────────────────────────────────────────
# DATABASE SETTINGS (MySQL)
# ─────────────────────────────────────────────────────────────
DB_DATABASE=natures_mud
DB_USERNAME=naturesmud
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
DB_ROOT_PASSWORD=CHANGE_THIS_TO_STRONG_ROOT_PASSWORD

# ─────────────────────────────────────────────────────────────
# LARAVEL BACKEND
# ─────────────────────────────────────────────────────────────
APP_NAME="Nature's Mud"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_URL=https://naturesmud.com
APP_TIMEZONE=Asia/Kathmandu

# Database (uses docker network hostname 'mysql')
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306

# Session & Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=.naturesmud.com
CACHE_STORE=redis
CACHE_PREFIX=naturesmud_
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# Queue
QUEUE_CONNECTION=redis

# Sanctum
SANCTUM_STATEFUL_DOMAINS=naturesmud.com,www.naturesmud.com,admin.naturesmud.com
FRONTEND_URL=https://naturesmud.com

# Meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=CHANGE_THIS_MEILI_KEY

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_SECURE=true

# Payment Gateways (fill in for production)
ESEWA_MERCHANT_ID=
ESEWA_SECRET_KEY=
KHALTI_SECRET_KEY=
FONEPAY_MERCHANT_CODE=
STRIPE_KEY=
STRIPE_SECRET=

# Twilio SMS
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# WhatsApp
WHATSAPP_NUMBER=9779713888002

# reCAPTCHA
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@naturesmud.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────
# ADMIN SERVER (Node.js)
# ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
API_PREFIX=/api/admin

# Admin Database (separate from Laravel)
# Uses same MySQL instance, different database
DATABASE_URL=mysql://${DB_USERNAME}:${DB_PASSWORD}@mysql:3306/natures_mud_admin

# Laravel Database (for reading orders, customers, products)
LARAVEL_DB_HOST=mysql
LARAVEL_DB_PORT=3306
LARAVEL_DB_DATABASE=${DB_DATABASE}
LARAVEL_DB_USER=${DB_USERNAME}
LARAVEL_DB_PASSWORD=${DB_PASSWORD}

# JWT Secrets - GENERATE WITH: openssl rand -base64 32
JWT_SECRET=GENERATE_32_CHAR_BASE64_STRING
JWT_REFRESH_SECRET=GENERATE_ANOTHER_32_CHAR_BASE64_STRING
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (Media Uploads)
CLOUDINARY_CLOUD_NAME=${CLOUDINARY_CLOUD_NAME}
CLOUDINARY_API_KEY=${CLOUDINARY_API_KEY}
CLOUDINARY_API_SECRET=${CLOUDINARY_API_SECRET}

# Gemini (AI Features)
GEMINI_API_KEY=

# SMTP (Email/OTP)
SMTP_HOST=${MAIL_HOST}
SMTP_PORT=${MAIL_PORT}
SMTP_USER=${MAIL_USERNAME}
SMTP_PASS=${MAIL_PASSWORD}
MAIL_FROM=${MAIL_FROM_ADDRESS}
MAIL_FROM_NAME=${MAIL_FROM_NAME}

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# CORS - Your production domains
CORS_ORIGIN=https://naturesmud.com,https://www.naturesmud.com,https://admin.naturesmud.com

# Super Admin Seed - CHANGE IN PRODUCTION!
SEED_SUPER_ADMIN_EMAIL=admin@naturesmud.com
SEED_SUPER_ADMIN_PASSWORD=GENERATE_STRONG_PASSWORD
SEED_SUPER_ADMIN_NAME="Super Admin"

# ─────────────────────────────────────────────────────────────
# NEXT.JS FRONTEND
# ─────────────────────────────────────────────────────────────
# These are embedded at BUILD TIME, so must be set during docker build
NEXT_PUBLIC_API_URL=https://naturesmud.com/api
NEXT_PUBLIC_ADMIN_API_URL=https://naturesmud.com/api/admin
NEXT_PUBLIC_SITE_URL=https://naturesmud.com

NEXT_PUBLIC_WHATSAPP_NUMBER=9779713888002
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hello Nature's Mud! I would like to know more about your products.

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Cloudinary (for frontend uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=${CLOUDINARY_CLOUD_NAME}
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ─────────────────────────────────────────────────────────────
# NGINX / SSL
# ─────────────────────────────────────────────────────────────
# SSL certificates managed by certbot
# Ensure domains point to server before running certbot init