# ── Nature's Mud — Frontend Environment ─────────────────────────

# API Base URL (Laravel backend - customer-facing)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Admin API Base URL (Node.js admin server)
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000/api/admin

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Business Platform / Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_NOTIFICATION_NUMBER=9779713888002

# WhatsApp Customer Link
NEXT_PUBLIC_WHATSAPP_NUMBER=9779713888002
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hello Nature's Mud! I would like to know more about your products.

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# For Docker internal networking (optional)
# INTERNAL_API_URL=http://backend:80/api
# INTERNAL_ADMIN_API_URL=http://admin-server:4000/api/admin